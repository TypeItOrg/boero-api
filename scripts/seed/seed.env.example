# Export these values in your shell; run.sh does not load this file automatically.
# Existing active institution's current slug (required, no environment-specific UUID).
SEED_INSTITUTION=codigo-de-tu-institucion
# Omit to use the current year. Pin it to reproduce a run.
SEED_YEAR=2026
SEED_DATASET=boero-2025
# Omit to use September 1 of SEED_YEAR. Must belong to that year.
SEED_REFERENCE_DATE=2026-09-01
SEED_TIMEZONE=America/Argentina/Cordoba
# compose (default) or psql (uses standard PG* connection variables).
SEED_TRANSPORT=compose
SEED_DB_SERVICE=postgres
# Optional alternative Compose file, absolute or relative to the repository root.
SEED_COMPOSE_FILE=
