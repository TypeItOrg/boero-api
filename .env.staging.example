# Deployment Configuration
APP_IMAGE=ghcr.io/typeitorg/boero-api
APP_VERSION=sha-replace-with-git-commit
APP_HOST_PORT=8080

# Resource Limits
APP_MEMORY_LIMIT=1024m
APP_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=boero_db
DB_USER=boero
DB_PASSWORD=change-me

# Security
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-for-hs256
REFRESH_REPLAY_ENCRYPTION_KEY=base64-encoded-32-byte-key
REFRESH_REPLAY_TTL=5s

# Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-to-a-strong-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
