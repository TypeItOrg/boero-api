# Server
SERVER_PORT=8080

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=boero_db
DB_USER=boero
DB_PASSWORD=boero

# Security
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-for-hs256
REFRESH_REPLAY_ENCRYPTION_KEY=base64-encoded-32-byte-key
REFRESH_REPLAY_TTL=5s

# Mail
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@boero.local

# Password recovery
PASSWORD_RECOVERY_FRONTEND_URL=http://localhost:3000
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Boero
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL=PT5M
WEBAUTHN_LOGIN_ATTEMPT_TTL=PT5M
WEBAUTHN_MAX_PASSKEYS=10
WEBAUTHN_RECENT_AUTH_TTL=PT5M

# Auth rate limiting
AUTH_RATE_LIMIT_KEY_SECRET=change-me-to-a-long-random-secret-for-rate-limit-key-hmac
RATE_LIMIT_IDENTIFY_IP_MAX=30
RATE_LIMIT_IDENTIFY_IP_WINDOW=PT1M
RATE_LIMIT_IDENTIFY_ACCOUNT_MAX=10
RATE_LIMIT_IDENTIFY_ACCOUNT_WINDOW=PT1M
RATE_LIMIT_PASSWORD_MAX=10
RATE_LIMIT_PASSWORD_WINDOW=PT1M
RATE_LIMIT_PASSWORD_IP_MAX=30
RATE_LIMIT_PASSWORD_IP_WINDOW=PT1M
RATE_LIMIT_WEBAUTHN_MAX=20
RATE_LIMIT_WEBAUTHN_WINDOW=PT1M
RATE_LIMIT_WEBAUTHN_IP_MAX=60
RATE_LIMIT_WEBAUTHN_IP_WINDOW=PT1M
RATE_LIMIT_REAUTH_MAX=10
RATE_LIMIT_REAUTH_WINDOW=PT1M
RATE_LIMIT_REAUTH_IP_MAX=30
RATE_LIMIT_REAUTH_IP_WINDOW=PT1M
RATE_LIMIT_RECOVERY_REQUEST_IP_MAX=10
RATE_LIMIT_RECOVERY_REQUEST_IP_WINDOW=PT1M
RATE_LIMIT_RECOVERY_REQUEST_ACCOUNT_MAX=5
RATE_LIMIT_RECOVERY_REQUEST_ACCOUNT_WINDOW=PT5M
RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
RATE_LIMIT_PASSWORD_RESET_IP_WINDOW=PT1M

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
