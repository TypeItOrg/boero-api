# Server
SERVER_PORT=8080

# Persistent storage path set by Compose.
STORAGE_LOCAL_DIR=/workspace/storage
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
AWS_REGION=us-east-1
STORAGE_S3_PREFIX=boero/
# Set AWS credentials in .env.dev; the container cannot use the host profile.
# Leave blank for local storage or when using an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when using temporary AWS credentials.
AWS_SESSION_TOKEN=

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=boero_db
DB_USER=boero
DB_PASSWORD=boero

# Security
JWT_SECRET=0123456789abcdef0123456789abcdef
REFRESH_REPLAY_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
REFRESH_REPLAY_TTL=5s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email verification
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
EMAIL_VERIFICATION_RESEND_INTERVAL=60s
