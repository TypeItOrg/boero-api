# Server
SERVER_PORT=8080

# Adjuntos: Compose fija esta ruta y la respalda con un volumen persistente.
ENROLLMENT_STORAGE_DIR=/workspace/storage/enrollments
ENROLLMENT_STORAGE_PROVIDER=local
ENROLLMENT_S3_BUCKET=
AWS_REGION=us-east-1
ENROLLMENT_S3_PREFIX=enrollments/

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=boero_db
DB_USER=boero
DB_PASSWORD=boero

# Security
JWT_SECRET=0123456789abcdef0123456789abcdef
REFRESH_REPLAY_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
REFRESH_REPLAY_TTL=5s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email verification
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
EMAIL_VERIFICATION_RESEND_INTERVAL=60s
