# Server
SERVER_PORT=8080

# Archivos de toda la aplicación: Compose fija esta ruta y la respalda con un volumen persistente.
STORAGE_LOCAL_DIR=/workspace/storage
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
AWS_REGION=us-east-1
STORAGE_S3_PREFIX=boero/
# Docker recibe estas variables desde .env.dev; no hereda ~/.aws del host.
# Dejar vacías con provider=local o si el contenedor tiene un rol IAM disponible.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Completar junto con las dos anteriores si las credenciales son temporales.
AWS_SESSION_TOKEN=

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=boero_db
DB_USER=boero
DB_PASSWORD=boero

# Security
JWT_SECRET=0123456789abcdef0123456789abcdef
REFRESH_REPLAY_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
REFRESH_REPLAY_TTL=5s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email verification
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
EMAIL_VERIFICATION_RESEND_INTERVAL=60s
